# Copy to .env and fill in. Polymarket's Gamma/CLOB/Data APIs need no auth.

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5

# Optional — enables saving contracts to a DB, keyed by title.
# Any Postgres works: Supabase (Project Settings -> Database -> Connection
# string -> URI), Neon, Railway, or local.
DATABASE_URL=
