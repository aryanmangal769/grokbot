# Shared secrets for both APIs (this file is gitignored).
# Copy from .env.example if needed, then fill in real values.

# --- xAI (https://console.x.ai/) ---
XAI_API_KEY=xai-your-key-here

# --- X / Twitter (https://console.x.com/accounts/2085957761431465984) ---
# App-only reads (user lookup, recent search)
X_BEARER_TOKEN=your-bearer-token-here

# OAuth 1.0a user context (me, post)
X_API_KEY=your-api-key-here
X_API_SECRET=your-api-secret-here
X_ACCESS_TOKEN=your-access-token-here
X_ACCESS_TOKEN_SECRET=your-access-token-secret-here
